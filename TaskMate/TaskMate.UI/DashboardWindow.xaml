<Window x:Class="TaskMate.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskMate.UI.ViewModels"
        Title="TaskMate - Panel de Control" Height="650" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9" FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:DashboardViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Columna 0: Barra Lateral (Sidebar) -->
            <ColumnDefinition Width="220"/>
            <!-- Columna 1: Contenido Principal -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR ==================== -->
        <Border Grid.Column="0" Background="#2C3E50">
            <DockPanel Margin="15,20">
                <!-- Branding -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,30">
                    <TextBlock Text="TaskMate" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Gestión de Proyectos" FontSize="11" Foreground="#BDC3C7" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Botón de Cerrar Sesión en la parte inferior -->
                <Button DockPanel.Dock="Bottom" Command="{Binding LogoutCommand}"
                        Content="Cerrar Sesión" Height="35" Background="#E74C3C" Foreground="White" 
                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Menú de Navegación -->
                <StackPanel>
                    <Button Content="📊 Inicio / Dashboard" Height="40" Background="#34495E" Foreground="White" 
                            HorizontalContentAlignment="Left" Padding="15,0" Margin="0,0,0,8" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="📁 Proyectos" Height="40" Background="Transparent" Foreground="#ECF0F1" 
                            HorizontalContentAlignment="Left" Padding="15,0" Margin="0,0,0,8" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="✅ Tareas" Height="40" Background="Transparent" Foreground="#ECF0F1" 
                            HorizontalContentAlignment="Left" Padding="15,0" Margin="0,0,0,8" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="🔔 Notificaciones" Height="40" Background="Transparent" Foreground="#ECF0F1" 
                            HorizontalContentAlignment="Left" Padding="15,0" Margin="0,0,0,8" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== ÁREA DE TRABAJO ==================== -->
        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Superior -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="¡Hola, " FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="{Binding NombreUsuario}" FontSize="20" FontWeight="Bold" Foreground="#3498DB"/>
                            <TextBlock Text="! 👋" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                        </StackPanel>
                        <TextBlock Text="Bienvenido a tu panel de control" FontSize="13" Foreground="#7F8C8D" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Right" Background="#EBF5FB" CornerRadius="15" Padding="12,6" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding RolUsuario}" FontWeight="SemiBold" Foreground="#2980B9" FontSize="12"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Panel Central vacante para vistas -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="25">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📌 Resumen Rápido" FontSize="18" FontWeight="Bold" Foreground="#34495E" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Aquí cargaremos las tarjetas de proyectos y tareas activas desde MySQL." FontSize="13" Foreground="#95A5A6" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
