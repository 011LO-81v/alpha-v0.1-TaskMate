<UserControl x:Class="TaskMate.Views.MiUsuarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskMate.ViewModels">

    <UserControl.DataContext>
        <vm:MiUsuarioViewModel/>
    </UserControl.DataContext>

    <StackPanel>
        <TextBlock Text="Mi Perfil" Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== Tarjeta de perfil ========== -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Background="#FAFAFB" VerticalAlignment="Top">
                <StackPanel>
                    <Ellipse Width="22" Height="22" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.5"
                             Fill="White" HorizontalAlignment="Center"/>
                    <Path Data="M 0,20 C 0,5 34,5 34,20" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.5"
                          HorizontalAlignment="Center" Margin="0,-4,0,10" Width="34" Height="20"/>

                    <TextBlock Text="{Binding NombreCompleto}" FontFamily="Segoe UI Semibold" FontSize="16"
                               HorizontalAlignment="Center" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding Cargo}" Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Correo}" Foreground="{StaticResource TextSecondary}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,12,0,16"/>

                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Proyectos}" FontFamily="Segoe UI Semibold" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Proyectos" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Background="{StaticResource CardBorderBrush}" Margin="8,0"/>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TareasActivas}" FontFamily="Segoe UI Semibold" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Tareas Activas" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="3" Width="1" Background="{StaticResource CardBorderBrush}" Margin="8,0"/>
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Completadas}" FontFamily="Segoe UI Semibold" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Completadas" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== Formulario de edición ========== -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Editar Información Personal" FontFamily="Segoe UI Semibold" FontSize="15" Margin="0,0,0,18"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nombre Completo" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource AppTextBox}" Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Correo Electrónico" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Teléfono" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Departamento" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Departamento, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,18"/>

                    <Button Content="Guardar cambios" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                            Command="{Binding GuardarCommand}" Height="23" Width="106"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
