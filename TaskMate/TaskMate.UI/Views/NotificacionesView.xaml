<UserControl x:Class="TaskMate.Views.NotificacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskMate.ViewModels"
             xmlns:hlp="clr-namespace:TaskMate.Helpers">

    <UserControl.DataContext>
        <vm:NotificacionesViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <hlp:NotifTipoToColorConverter x:Key="NotifColor"/>
        <hlp:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,20">
            <TextBlock Text="Notificaciones" Style="{StaticResource PageTitle}"/>
            <Button Content="Marcar todas como leídas" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                    Foreground="{StaticResource PrimaryBrush}" Command="{Binding MarcarTodasLeidasCommand}"/>
        </Grid>

        <ItemsControl ItemsSource="{Binding Notificaciones}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Padding="18,16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Margin="0,4,14,0" VerticalAlignment="Top"
                                    Background="{Binding Tipo, Converter={StaticResource NotifColor}}"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Titulo}" FontFamily="Segoe UI Semibold" FontSize="13.5"/>
                                <TextBlock Text="{Binding Descripcion}" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Tiempo}" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="7" Height="7" CornerRadius="3.5" Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0"
                                        Visibility="{Binding EsNoLeida, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="Marcar leída" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12"
                                        Command="{Binding DataContext.MarcarLeidaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
