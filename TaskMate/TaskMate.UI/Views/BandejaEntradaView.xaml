<UserControl x:Class="TaskMate.Views.BandejaEntradaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskMate.ViewModels">

    <UserControl.DataContext>
        <vm:BandejaEntradaViewModel/>
    </UserControl.DataContext>

    <Grid MinHeight="500">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="72" Height="72" BorderBrush="{StaticResource TextMuted}" BorderThickness="1.5"
                    CornerRadius="4" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding Mensaje}" Foreground="{StaticResource TextSecondary}" FontSize="14"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,24"/>
            <Button Content="+ Crear Tarea" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                    Padding="22,10" Command="{Binding CrearTareaCommand}">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="18"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
