<UserControl x:Class="TaskMate.Views.CalendarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskMate.ViewModels"
             xmlns:hlp="clr-namespace:TaskMate.Helpers">

    <UserControl.DataContext>
        <vm:CalendarioViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <hlp:BadgeBackgroundConverter x:Key="BadgeBg"/>
        <hlp:BadgeForegroundConverter x:Key="BadgeFg"/>
        <hlp:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <hlp:StringNotEmptyToVisibilityConverter x:Key="NotEmptyToVis"/>
    </UserControl.Resources>

    <StackPanel>
        <!-- Encabezado -->
        <Grid Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Calendario" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource LinkButton}"
                        Margin="20,0,8,0" Command="{Binding MesAnteriorCommand}"/>
                <TextBlock Text="{Binding MesActual}" FontFamily="Segoe UI Semibold" FontSize="15" VerticalAlignment="Center"/>
                <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource LinkButton}"
                        Margin="8,0,0,0" Command="{Binding MesSiguienteCommand}"/>
            </StackPanel>

            <Border HorizontalAlignment="Right" Background="{StaticResource SubtleBg}" CornerRadius="6" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <Border Background="White" CornerRadius="4" Padding="14,5" Margin="0,0,2,0">
                        <TextBlock Text="Mes" FontFamily="Segoe UI Semibold" FontSize="12.5"/>
                    </Border>
                    <Border Padding="14,5">
                        <TextBlock Text="Semana" Foreground="{StaticResource TextSecondary}" FontSize="12.5"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Cuadrícula del calendario -->
            <Border Grid.Column="0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <StackPanel>
                    <UniformGrid Columns="7" Background="{StaticResource SubtleBg}">
                        <TextBlock Text="Lun" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,8"/>
                        <TextBlock Text="Mar" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,8"/>
                        <TextBlock Text="Mié" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,8"/>
                        <TextBlock Text="Jue" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,8"/>
                        <TextBlock Text="Vie" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,8"/>
                        <TextBlock Text="Sáb" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,8"/>
                        <TextBlock Text="Dom" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,8"/>
                    </UniformGrid>

                    <ItemsControl ItemsSource="{Binding Dias}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0.5" Height="90" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Dia}" FontSize="13" HorizontalAlignment="Left">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DelMesActual}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Background="{Binding ColorEtiqueta, Converter={StaticResource BadgeBg}}"
                                                CornerRadius="4" Padding="6,2" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                Visibility="{Binding Etiqueta, Converter={StaticResource NotEmptyToVis}}">
                                            <TextBlock Text="{Binding Etiqueta}" FontSize="10.5" FontFamily="Segoe UI Semibold"
                                                       Foreground="{Binding ColorEtiqueta, Converter={StaticResource BadgeFg}}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Tareas del día -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Tareas del 11 de Agosto" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding TareasDelDia}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SubtleBg}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Titulo}" FontFamily="Segoe UI Semibold" FontSize="12.5" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Badge}" Padding="8,2"
                                                    Background="{Binding Prioridad, Converter={StaticResource BadgeBg}}">
                                                <TextBlock Text="{Binding Prioridad}" FontSize="10.5" FontFamily="Segoe UI Semibold"
                                                           Foreground="{Binding Prioridad, Converter={StaticResource BadgeFg}}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Hora}" Foreground="{StaticResource TextSecondary}" FontSize="11.5"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
