<UserControl x:Class="TaskMate.UI.Views.AjustesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TaskMate.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">


    <UserControl.DataContext>
        <vm:AjustesViewModel/>
    </UserControl.DataContext>

    <StackPanel>
        <TextBlock Text="Ajustes" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Preferencias de la cuenta y de la aplicación" Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- Notificaciones -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Notificaciones" FontFamily="Segoe UI Semibold" FontSize="15" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="Nueva tarea asignada" FontSize="13"/>
                                <TextBlock Text="Avisarme cuando me asignen una tarea" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding NotifTareaAsignada}"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="Tareas próximas a vencer" FontSize="13"/>
                                <TextBlock Text="Recordatorio antes de la fecha límite" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding NotifTareaVencer}"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="Comentarios y menciones" FontSize="13"/>
                                <TextBlock Text="Avisarme de comentarios en mis tareas" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding NotifComentarios}"/>
                        </Grid>

                        <Grid>
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="Resumen semanal por correo" FontSize="13"/>
                                <TextBlock Text="Un resumen de tu productividad cada lunes" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding NotifResumenSemanal}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Apariencia e idioma -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Apariencia e idioma" FontFamily="Segoe UI Semibold" FontSize="15" Margin="0,0,0,16"/>
                        <TextBlock Text="Tema" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource AppComboBox}" Margin="0,0,0,16"
                                  ItemsSource="{Binding Temas}" SelectedItem="{Binding TemaSeleccionado}"/>
                        <TextBlock Text="Idioma" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource AppComboBox}"
                                  ItemsSource="{Binding Idiomas}" SelectedItem="{Binding IdiomaSeleccionado}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Seguridad -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Seguridad" FontFamily="Segoe UI Semibold" FontSize="15" Margin="0,0,0,16"/>

                    <TextBlock Text="Contraseña actual" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PwdActual" Padding="10,8" BorderBrush="{StaticResource CardBorderBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="Nueva contraseña" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PwdNueva" Padding="10,8" BorderBrush="{StaticResource CardBorderBrush}" Margin="0,0,0,20"/>

                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,18"/>

                    <TextBlock Text="Sesión" FontFamily="Segoe UI Semibold" FontSize="13.5" Margin="0,0,0,10"/>
                    <Button Content="Cerrar sesión" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,18"/>

                    <Button Content="Guardar cambios" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                            Command="{Binding CambiarPasswordCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
