<UserControl x:Class="TaskMate.Views.FiltroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskMate.ViewModels"
             xmlns:hlp="clr-namespace:TaskMate.Helpers">

    <UserControl.DataContext>
        <vm:FiltroViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <hlp:BadgeBackgroundConverter x:Key="BadgeBg"/>
        <hlp:BadgeForegroundConverter x:Key="BadgeFg"/>
        <hlp:StringEqualsToBoolConverter x:Key="EqualsToBool"/>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Filtros" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Configura criterios detallados para buscar y exportar tareas"
                   Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== Panel de filtros ========== -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Estado" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,10">
                        <ToggleButton Style="{StaticResource FilterChipToggle}" Content="Pendiente" Command="{Binding SeleccionarEstadoCommand}" CommandParameter="Pendiente"
                                      IsChecked="{Binding EstadoSeleccionado, Converter={StaticResource EqualsToBool}, ConverterParameter=Pendiente, Mode=OneWay}"/>
                        <ToggleButton Style="{StaticResource FilterChipToggle}" Content="En progreso" Command="{Binding SeleccionarEstadoCommand}" CommandParameter="En progreso"
                                      IsChecked="{Binding EstadoSeleccionado, Converter={StaticResource EqualsToBool}, ConverterParameter=En progreso, Mode=OneWay}"/>
                        <ToggleButton Style="{StaticResource FilterChipToggle}" Content="En revisión" Command="{Binding SeleccionarEstadoCommand}" CommandParameter="En revisión"
                                      IsChecked="{Binding EstadoSeleccionado, Converter={StaticResource EqualsToBool}, ConverterParameter=En revisión, Mode=OneWay}"/>
                        <ToggleButton Style="{StaticResource FilterChipToggle}" Content="Completada" Command="{Binding SeleccionarEstadoCommand}" CommandParameter="Completada"
                                      IsChecked="{Binding EstadoSeleccionado, Converter={StaticResource EqualsToBool}, ConverterParameter=Completada, Mode=OneWay}"/>
                    </WrapPanel>

                    <TextBlock Text="Prioridad" Style="{StaticResource FieldLabel}" Margin="0,4,0,8"/>
                    <WrapPanel Margin="0,0,0,10">
                        <ToggleButton Style="{StaticResource FilterChipToggle}" Content="Baja" Command="{Binding SeleccionarPrioridadCommand}" CommandParameter="Baja"
                                      IsChecked="{Binding PrioridadSeleccionada, Converter={StaticResource EqualsToBool}, ConverterParameter=Baja, Mode=OneWay}"/>
                        <ToggleButton Style="{StaticResource FilterChipToggle}" Content="Media" Command="{Binding SeleccionarPrioridadCommand}" CommandParameter="Media"
                                      IsChecked="{Binding PrioridadSeleccionada, Converter={StaticResource EqualsToBool}, ConverterParameter=Media, Mode=OneWay}"/>
                        <ToggleButton Style="{StaticResource FilterChipToggle}" Content="Alta" Command="{Binding SeleccionarPrioridadCommand}" CommandParameter="Alta"
                                      IsChecked="{Binding PrioridadSeleccionada, Converter={StaticResource EqualsToBool}, ConverterParameter=Alta, Mode=OneWay}"/>
                        <ToggleButton Style="{StaticResource FilterChipToggle}" Content="Urgente" Command="{Binding SeleccionarPrioridadCommand}" CommandParameter="Urgente"
                                      IsChecked="{Binding PrioridadSeleccionada, Converter={StaticResource EqualsToBool}, ConverterParameter=Urgente, Mode=OneWay}"/>
                    </WrapPanel>

                    <TextBlock Text="Proyecto" Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
                    <ComboBox Style="{StaticResource AppComboBox}" Margin="0,0,0,16"
                              ItemsSource="{Binding Proyectos}" SelectedItem="{Binding ProyectoSeleccionado}"/>

                    <TextBlock Text="Responsable" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource AppComboBox}" Margin="0,0,0,20"
                              ItemsSource="{Binding Responsables}" SelectedItem="{Binding ResponsableSeleccionado}"/>

                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                    <Grid>
                        <Button Content="Limpiar filtros" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                Command="{Binding LimpiarFiltrosCommand}"/>
                        <Button Content="Aplicar filtros" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                Command="{Binding AplicarFiltrosCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== Resultados ========== -->
            <StackPanel Grid.Column="2">
                <TextBlock FontFamily="Segoe UI Semibold" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12" Text="{Binding TotalResultados, StringFormat='RESULTADOS FILTRADOS ({0})'}"/>
                <ItemsControl ItemsSource="{Binding ResultadosFiltrados}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Titulo}" FontFamily="Segoe UI Semibold" FontSize="13.5"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" Text="Asignado a: "/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" Text="{Binding Responsable}"/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" Text=" | Fecha límite: "/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" Text="{Binding FechaLimite}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Badge}"
                                            Background="{Binding Prioridad, Converter={StaticResource BadgeBg}}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Prioridad}" Style="{StaticResource BadgeText}"
                                                   Foreground="{Binding Prioridad, Converter={StaticResource BadgeFg}}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
             