<UserControl x:Class="TaskMate.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskMate.ViewModels"
             xmlns:hlp="clr-namespace:TaskMate.Helpers">

    <UserControl.DataContext>
        <vm:ReportesViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <hlp:HexToBrushConverter x:Key="HexBrush"/>
        <hlp:PercentToWidthConverter x:Key="PercentWidth"/>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Reportes" Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>

        <!-- ========== Fila de tarjetas resumen XD ========== -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Tareas Completadas" Style="{StaticResource PageSubtitle}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding TareasCompletadas}" FontFamily="Segoe UI Semibold" FontSize="28"/>
                        <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="10,0,0,4" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding DeltaCompletadas}" FontFamily="Segoe UI Semibold" FontSize="11" Foreground="#16A34A"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Tareas Pendientes" Style="{StaticResource PageSubtitle}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding TareasPendientes}" FontFamily="Segoe UI Semibold" FontSize="28"/>
                    <TextBlock Text="En progreso" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Tareas Atrasadas" Style="{StaticResource PageSubtitle}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding TareasAtrasadas}" FontFamily="Segoe UI Semibold" FontSize="28" Foreground="#DC2626"/>
                    <Border Background="#FEE2E2" CornerRadius="4" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="Acción Requerida" FontFamily="Segoe UI Semibold" FontSize="10.5" Foreground="#DC2626"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========== Fila: Productividad + Donut ========== -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Productividad por usuario -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Productividad por usuario" FontFamily="Segoe UI Semibold" FontSize="14.5" Margin="0,0,0,18"/>
                    <ItemsControl ItemsSource="{Binding ProductividadPorUsuario}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Nombre}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" x:Name="Track" Height="9" CornerRadius="4.5"
                                            Background="{StaticResource SubtleBg}" VerticalAlignment="Center" Margin="8,0">
                                        <Border HorizontalAlignment="Left" Height="9" CornerRadius="4.5" Background="{StaticResource PrimaryBrush}">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource PercentWidth}">
                                                    <Binding Path="Horas"/>
                                                    <Binding ElementName="Track" Path="ActualWidth"/>
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Border>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" Text="{Binding Horas}"/>
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" Text=" hrs"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Tareas por estado (donut) -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Tareas por estado" FontFamily="Segoe UI Semibold" FontSize="14.5" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="180" Height="180">
                            <Canvas Width="180" Height="180">
                                <Path Fill="#2563EB" Data="M 90,20 A 70,70 0 1 1 48.85,146.63 L 63.55,126.41 A 45,45 0 1 0 90,45 Z"/>
                                <Path Fill="#22C55E" Data="M 48.85,146.63 A 70,70 0 0 1 33.37,48.85 L 53.59,63.55 A 45,45 0 0 0 63.55,126.41 Z"/>
                                <Path Fill="#EF4444" Data="M 33.37,48.85 A 70,70 0 0 1 90,20 L 90,45 A 45,45 0 0 0 53.59,63.55 Z"/>
                            </Canvas>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalTareasEstado}" FontFamily="Segoe UI Semibold" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="T" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#2563EB" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="12.5" Text="Completado ("/>
                                    <TextBlock FontSize="12.5" Text="{Binding PctCompletado}"/>
                                    <TextBlock FontSize="12.5" Text=")"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#22C55E" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="12.5" Text="En progreso ("/>
                                    <TextBlock FontSize="12.5" Text="{Binding PctEnProgreso}"/>
                                    <TextBlock FontSize="12.5" Text=")"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#EF4444" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="12.5" Text="Atrasado ("/>
                                    <TextBlock FontSize="12.5" Text="{Binding PctAtrasado}"/>
                                    <TextBlock FontSize="12.5" Text=")"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========== Progreso de proyectos ========== -->
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Progreso de proyectos" FontFamily="Segoe UI Semibold" FontSize="14.5" Margin="0,0,0,18"/>
                <ItemsControl ItemsSource="{Binding ProgresoProyectos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Nombre}" FontSize="13" HorizontalAlignment="Left"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock FontFamily="Segoe UI Semibold" FontSize="13" Text="{Binding Porcentaje}"/>
                                        <TextBlock FontFamily="Segoe UI Semibold" FontSize="13" Text="%"/>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="Track" Height="9" CornerRadius="4.5" Background="{StaticResource SubtleBg}">
                                    <Border HorizontalAlignment="Left" Height="9" CornerRadius="4.5"
                                            Background="{Binding ColorHex, Converter={StaticResource HexBrush}}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentWidth}">
                                                <Binding Path="Porcentaje"/>
                                                <Binding ElementName="Track" Path="ActualWidth"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>