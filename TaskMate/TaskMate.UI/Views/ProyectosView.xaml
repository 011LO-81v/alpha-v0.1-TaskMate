<UserControl x:Class="TaskMate.Views.ProyectosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskMate.ViewModels"
             xmlns:hlp="clr-namespace:TaskMate.Helpers">

    <UserControl.DataContext>
        <vm:ProyectosViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <hlp:BadgeBackgroundConverter x:Key="BadgeBg"/>
        <hlp:BadgeForegroundConverter x:Key="BadgeFg"/>
        <hlp:EstadoToProgressColorConverter x:Key="BarColor"/>
        <hlp:PercentToWidthConverter x:Key="PercentWidth"/>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Proyectos" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Gestiona y monitorea el estado general de tus iniciativas" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="+ Nuevo Proyecto" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding NuevoProyectoCommand}"/>
        </Grid>

        <ItemsControl ItemsSource="{Binding Proyectos}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Padding="20,18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <!-- Nombre + estado + descripción -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Nombre}" FontFamily="Segoe UI Semibold" FontSize="15"/>
                                    <Border Style="{StaticResource Badge}" Margin="10,0,0,0"
                                            Background="{Binding Estado, Converter={StaticResource BadgeBg}}">
                                        <TextBlock Text="{Binding Estado}" Style="{StaticResource BadgeText}"
                                                   Foreground="{Binding Estado, Converter={StaticResource BadgeFg}}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Descripcion}" Foreground="{StaticResource TextSecondary}"
                                           FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Responsable -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Responsable" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Responsable}" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Tareas -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Tareas" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBlock FontSize="12.5">
                                    <Run Text="{Binding TotalTareas}"/><Run Text=" tareas"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Progreso -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Progreso" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Left"/>
                                    <TextBlock FontFamily="Segoe UI Semibold" FontSize="12.5" HorizontalAlignment="Right">
                                        <Run Text="{Binding Progreso}"/><Run Text="%"/>
                                    </TextBlock>
                                </Grid>
                                <Border x:Name="Track" Height="7" CornerRadius="3.5" Background="{StaticResource SubtleBg}">
                                    <Border HorizontalAlignment="Left" Height="7" CornerRadius="3.5"
                                            Background="{Binding Estado, Converter={StaticResource BarColor}}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentWidth}">
                                                <Binding Path="Progreso"/>
                                                <Binding ElementName="Track" Path="ActualWidth"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>
                            </StackPanel>

                            <!-- Menú -->
                            <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" BorderThickness="0" Background="Transparent"
                                    Padding="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Command="{Binding DataContext.VerOpcionesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextSecondary}"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
