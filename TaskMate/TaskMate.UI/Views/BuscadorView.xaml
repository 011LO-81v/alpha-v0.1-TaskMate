<UserControl x:Class="TaskMate.UI.Views.BuscadorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TaskMate.UI.ViewModels"
             xmlns:hlp="clr-namespace:TaskMate.UI.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:BuscadorViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <hlp:BadgeBackgroundConverter x:Key="BadgeBg"/>
        <hlp:BadgeForegroundConverter x:Key="BadgeFg"/>
        <hlp:StringEqualsToBoolConverter x:Key="EqualsToBool"/>
    </UserControl.Resources>

    <StackPanel>
        <!-- Barra de búsqueda -->
        <Border Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBox BorderThickness="0" Background="Transparent" Margin="10,0,0,0" FontSize="14" VerticalAlignment="Center"
                         Width="600" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Buscar tareas, proyectos, usuarios..."/>
            </StackPanel>
        </Border>

        <!-- Pestañas -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <ToggleButton Style="{StaticResource PillToggle}" Content="Todas" Margin="0,0,8,0"
                          IsChecked="{Binding PestanaActiva, Converter={StaticResource EqualsToBool}, ConverterParameter=Todas, Mode=OneWay}"
                          Command="{Binding SeleccionarPestanaCommand}" CommandParameter="Todas"/>
            <ToggleButton Style="{StaticResource PillToggle}" Content="Tareas" Margin="0,0,8,0"
                          IsChecked="{Binding PestanaActiva, Converter={StaticResource EqualsToBool}, ConverterParameter=Tareas, Mode=OneWay}"
                          Command="{Binding SeleccionarPestanaCommand}" CommandParameter="Tareas"/>
            <ToggleButton Style="{StaticResource PillToggle}" Content="Proyectos" Margin="0,0,8,0"
                          IsChecked="{Binding PestanaActiva, Converter={StaticResource EqualsToBool}, ConverterParameter=Proyectos, Mode=OneWay}"
                          Command="{Binding SeleccionarPestanaCommand}" CommandParameter="Proyectos"/>
            <ToggleButton Style="{StaticResource PillToggle}" Content="Usuarios" Margin="0,0,8,0"
                          IsChecked="{Binding PestanaActiva, Converter={StaticResource EqualsToBool}, ConverterParameter=Usuarios, Mode=OneWay}"
                          Command="{Binding SeleccionarPestanaCommand}" CommandParameter="Usuarios"/>
            <ToggleButton Style="{StaticResource PillToggle}" Content="Comentarios"
                          IsChecked="{Binding PestanaActiva, Converter={StaticResource EqualsToBool}, ConverterParameter=Comentarios, Mode=OneWay}"
                          Command="{Binding SeleccionarPestanaCommand}" CommandParameter="Comentarios"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="TAREAS" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Tareas}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SubtleBg}" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Titulo}" FontFamily="Segoe UI Semibold" FontSize="13.5"/>
                                        <TextBlock Text="{Binding Proyecto}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Badge}"
                                            Background="{Binding Prioridad, Converter={StaticResource BadgeBg}}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Prioridad}" Style="{StaticResource BadgeText}"
                                                   Foreground="{Binding Prioridad, Converter={StaticResource BadgeFg}}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="PROYECTOS" Style="{StaticResource SectionLabel}" Margin="0,10,0,10"/>
                <ItemsControl ItemsSource="{Binding Proyectos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SubtleBg}" CornerRadius="8" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Nombre}" FontFamily="Segoe UI Semibold" FontSize="13.5"/>
                                        <TextBlock Text="{Binding Descripcion}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="Segoe UI Semibold" FontSize="13">
                                        <Run Text="{Binding Progreso}"/><Run Text="% completado"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="BÚSQUEDA AVANZADA" Style="{StaticResource SectionLabel}" Margin="0,0,0,16"/>
                    <TextBlock Text="Ordenar por" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource AppComboBox}" Margin="0,0,0,16"
                              ItemsSource="{Binding OpcionesOrden}" SelectedItem="{Binding OrdenSeleccionado}"/>
                    <TextBlock Text="Fecha de creación" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource AppComboBox}"
                              ItemsSource="{Binding OpcionesFecha}" SelectedItem="{Binding FechaSeleccionada}"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
