<Window x:Class="TaskMate.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskMate.UI.ViewModels"
        Title="TaskMate - Iniciar Sesión" Height="450" Width="350"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" FontFamily="Segoe UI">

    <!-- 1. Aquí conectamos esta ventana gráfica con nuestro "Traductor" (LoginViewModel) -->
    <Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>

    <Grid>
        <Border Background="White" CornerRadius="10" Margin="30" Padding="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <!-- Títulos -->
                <TextBlock Text="TaskMate" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Inicia sesión para continuar" FontSize="13" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- Campo Correo -->
                <TextBlock Text="Correo Electrónico" FontSize="12" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}" Height="35" Padding="5" Margin="0,0,0,15" />

                <!-- Campo Contraseña -->
                <TextBlock Text="Contraseña" FontSize="12" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Height="35" Padding="5" Margin="0,0,0,15"/>

                <!-- Mensaje de Error dinámico -->
                <TextBlock Text="{Binding MensajeError}" Foreground="#E74C3C" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap" TextAlignment="Center"/>

                <!-- Botón de Ingreso (Envía el PasswordBox completo por seguridad) -->
                <Button Content="INGRESAR" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=txtPassword}"
                        Height="40" Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
